# Required
ANTHROPIC_API_KEY=sk-ant-...

# LinkedIn credentials (for Sales Navigator scraping)
LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=your-password

# Apollo.io (alternative to LinkedIn scraping)
# APOLLO_API_KEY=your-apollo-api-key

# Optional overrides
# BROWSER_PROFILE_DIR=~/.prospect_browser
# DB_PATH=./prospect_data.db
# LINKEDIN_DAILY_LIMIT=80
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ── ICP Configuration ──
# Company size ranges (comma-separated)
ICP_COMPANY_SIZES=11-50,51-200

# Funding stages (comma-separated)
ICP_FUNDING_STAGES=Seed,Series A,Series B,Series C

# Target industries (comma-separated)
ICP_INDUSTRIES=fintech,logistics,marketplace,SaaS,proptech,healthcare technology,betting,gaming,manufacturing

# Buyer persona job titles (comma-separated)
ICP_TITLES=CEO,Founder,Co-Founder,CTO,Chief Technology Officer,VP Engineering,VP of Engineering,Head of Engineering,Head of Product,Product Director,VP Product

# Industries to exclude (comma-separated, optional)
# ICP_EXCLUDE_INDUSTRIES=staffing,recruiting,consulting

# Geographic focus (comma-separated, empty = worldwide)
# ICP_LOCATIONS=United States,United Kingdom,Europe
